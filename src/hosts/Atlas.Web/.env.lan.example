# Copy to .env.lan.local and set your PC's current Wi-Fi/Ethernet IPv4 address.
ATLAS_LAN_ORIGIN=https://192.168.50.55:5173

# Windows defaults: %LOCALAPPDATA%/Atlas/dev-certs/atlas.pem and atlas-key.pem.
# Override both paths if stored elsewhere (required on other operating systems).
# ATLAS_LAN_CERT=C:/path/to/atlas.pem
# ATLAS_LAN_KEY=C:/path/to/atlas-key.pem
