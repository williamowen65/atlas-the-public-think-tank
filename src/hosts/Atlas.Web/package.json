{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test": "playwright test",
    "test:ci": "npm run build && npm run build-storybook && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "@types/node": "^24.19.2",
    "storybook": "10.6.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
