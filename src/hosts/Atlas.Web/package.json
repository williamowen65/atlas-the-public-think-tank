{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "npm run check && vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test": "playwright test",
    "test:ci": "npm run build && npm run build-storybook && npm test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "storybook:api": "concurrently --kill-others --names API,Storybook \"dotnet run --project ../Atlas.Api --launch-profile https\" \"npm run storybook\"",
    "format": "prettier --write \"src/**/*.svelte\" \"storybook/**/*.svelte\" \"src/routes/+layout.ts\" \"src/styles.scss\"",
    "format:check": "prettier --check \"src/**/*.svelte\" \"storybook/**/*.svelte\" \"src/routes/+layout.ts\" \"src/styles.scss\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/sveltekit": "10.6.3",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.2",
    "storybook": "10.6.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  }
}
