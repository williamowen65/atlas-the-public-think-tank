<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dedicated command host for local setup, Azure SSH and the protected bootstrap WebJob.
       No interactive Console UI or public HTTP endpoints. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Atlas.Admin</AssemblyName>
    <!-- Same local User Secrets store as Atlas.Api and Atlas.Console. -->
    <UserSecretsId>02103f3e-daff-4644-b045-6eb5f00889eb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Atlas.Application/Atlas.Application.csproj" />
    <ProjectReference Include="../../Atlas.Identity/Atlas.Identity.csproj" />
    <ProjectReference Include="../../Atlas.Persistence/Atlas.Persistence.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
  </ItemGroup>

</Project>
