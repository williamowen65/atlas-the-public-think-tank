,{"id":"2knIhVDoCDs4gmvQfUz3H","type":"rectangle","x":4174.925358039506,"y":1484.9679052124097,"width":623.3729407546491,"height":118.91917625067157,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["T1FPJDEWa2Jac7dBFRY8o","FEnV2BMa7npD4PvfGdzYG"],"frameId":null,"index":"b5x","roundness":{"type":3},"seed":269851188,"version":2568,"versionNonce":1219434804,"isDeleted":false,"boundElements":[],"updated":1788982845461,"link":null,"locked":false},{"id":"VlAO53tnNKlaC4Rp_QvuV","type":"text","x":4174.651017481976,"y":1438.8662166842428,"width":664.9486631114165,"height":32.8558121537879,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["FEnV2BMa7npD4PvfGdzYG"],"frameId":null,"index":"b5y","roundness":null,"seed":608973748,"version":1190,"versionNonce":559915572,"isDeleted":false,"boundElements":[],"updated":1788982854516,"link":null,"locked":false,"text":"14. User receives confirmation","fontSize":26.284649723030324,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"14. User receives confirmation","autoResize":false,"lineHeight":1.25},{"id":"k6-i6ZeHGvfpeTrrPb_NV","type":"rectangle","x":3767.4971494380966,"y":-249.29750938312367,"width":807.186554786486,"height":400.31074502223726,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["IEYQ3qvLmPbON74NLkLlx","cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b61","roundness":{"type":3},"seed":1057842700,"version":2332,"versionNonce":1879646348,"isDeleted":false,"boundElements":[],"updated":1788983499681,"link":null,"locked":false},{"id":"JLRejsZmUtO7lkOK_vVxd","type":"text","x":3800.0870983340183,"y":-229.78357298364006,"width":686.7988088815666,"height":61.61623164069352,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b62","roundness":null,"seed":482184076,"version":446,"versionNonce":1224736308,"isDeleted":false,"boundElements":null,"updated":1788983499681,"link":null,"locked":false,"text":"1. User starts node creation","fontSize":49.292985312554855,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. User starts node creation","autoResize":true,"lineHeight":1.25},{"id":"9iJBLAUExzKtvWIAhPwOd","type":"text","x":3803.2933628347346,"y":-152.5063807508289,"width":653.4895629882812,"height":270,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["IEYQ3qvLmPbON74NLkLlx","cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b63","roundness":null,"seed":279641484,"version":77,"versionNonce":1168977676,"isDeleted":false,"boundElements":null,"updated":1788983499681,"link":null,"locked":false,"text":"The selected Participant chooses “Create node” from the Console menu.\n\nConsoleApplication.CreateNode() starts the shared NodeCreationWorkflow.\n\nThe workflow receives:\n- Node repository\n- Node type repository\n- Document repository\n- Current Participant\n- Event publisher\n\nNo domain objects have been created yet.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The selected Participant chooses “Create node” from the Console menu.\n\nConsoleApplication.CreateNode() starts the shared NodeCreationWorkflow.\n\nThe workflow receives:\n- Node repository\n- Node type repository\n- Document repository\n- Current Participant\n- Event publisher\n\nNo domain objects have been created yet.","autoResize":true,"lineHeight":1.25},{"id":"C3eYjQMI_MOyBk6zlPnRi","type":"text","x":1535.7604024558382,"y":143.26933760782697,"width":1012.697509765625,"height":405,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["W5kpz8RCuhNM9ZfJeAIKn"],"frameId":null,"index":"b64","roundness":null,"seed":402715060,"version":85,"versionNonce":1108360244,"isDeleted":false,"boundElements":null,"updated":1788983713980,"link":null,"locked":false,"text":"The Console Host constructs a new Graph Node.\n\nGraph generates:\n- A new NodeId\n- Active status\n- CreatedAt and UpdatedAt timestamps\n\nGraph stores:\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- Requested sub-node type IDs\n- Parent node IDs, initially empty\n\nThe DescriptionId is a reference to Content’s Document. The Node does not contain or own the description text.\n\nThe Node now exists in memory but has not yet been persisted.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host constructs a new Graph Node.\n\nGraph generates:\n- A new NodeId\n- Active status\n- CreatedAt and UpdatedAt timestamps\n\nGraph stores:\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- Requested sub-node type IDs\n- Parent node IDs, initially empty\n\nThe DescriptionId is a reference to Content’s Document. The Node does not contain or own the description text.\n\nThe Node now exists in memory but has not yet been persisted.","autoResize":true,"lineHeight":1.25},{"id":"32zMlvPpcJiqcFixq9fbq","type":"text","x":3483.400137124679,"y":2952.46947443892,"width":976.5714111328125,"height":315,"angle":6.283217800236468,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["saDZwJ26qyYrnuUSe2qxX"],"frameId":null,"index":"b65","roundness":null,"seed":1431942324,"version":53,"versionNonce":990998324,"isDeleted":false,"boundElements":null,"updated":1788983819682,"link":null,"locked":false,"text":"The Console Host calls:\n\ndocuments.Save(document)\n\nThe Content repository converts the Document into a StoredDocument and writes it to data/documents.json.\n\nStored document schema:\n- Id\n- Content\n- CreatedAt\n\nIf the ID already exists, the repository replaces that record. Otherwise, it adds a new record.\n\nThe description is now persistent, but the Graph Node has not been created yet.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host calls:\n\ndocuments.Save(document)\n\nThe Content repository converts the Document into a StoredDocument and writes it to data/documents.json.\n\nStored document schema:\n- Id\n- Content\n- CreatedAt\n\nIf the ID already exists, the repository replaces that record. Otherwise, it adds a new record.\n\nThe description is now persistent, but the Graph Node has not been created yet.","autoResize":true,"lineHeight":1.25},{"id":"WxXtRXPPqFJfiHg1r1S2E","type":"text","x":2067.638498501946,"y":2224.4438536737857,"width":793.20556640625,"height":337.5,"angle":0.00003249305688157733,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["BwKUADk94kGiAIHv71UQB"],"frameId":null,"index":"b66","roundness":null,"seed":836878988,"version":186,"versionNonce":644802188,"isDeleted":false,"boundElements":null,"updated":1788983896334,"link":null,"locked":false,"text":"Content returns the created Document, including its DocumentId, to the Console Host.\n\nThe Console Host converts the Content-owned identifier into Graph’s reference type:\n\nnew NodeDescriptionId(document.Id.Value)\n\nThe Console Host then supplies Graph with:\n- NodeTitle\n- NodeDescriptionId\n- NodeTypeId\n- NodeAuthorId\n- Requested sub-node type IDs\n- Creation timestamp\n\nThe description text does not cross into Graph. Only its identifier crosses the boundary.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Content returns the created Document, including its DocumentId, to the Console Host.\n\nThe Console Host converts the Content-owned identifier into Graph’s reference type:\n\nnew NodeDescriptionId(document.Id.Value)\n\nThe Console Host then supplies Graph with:\n- NodeTitle\n- NodeDescriptionId\n- NodeTypeId\n- NodeAuthorId\n- Requested sub-node type IDs\n- Creation timestamp\n\nThe description text does not cross into Graph. Only its identifier crosses the boundary.","autoResize":true,"lineHeight":1.25},{"id":"6Pap3FO0WiggBSbzccZWc","type":"text","x":556.5254437949345,"y":49.77355415440297,"width":563.3259815163465,"height":315,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["F1itjXOWTY8NqLSU3bU-k","QZSHvYK5cSU2KsEuWhw4m"],"frameId":null,"index":"b67","roundness":null,"seed":439884596,"version":374,"versionNonce":1412298164,"isDeleted":false,"boundElements":null,"updated":1788984158299,"link":null,"locked":false,"text":"As part of Node construction, Graph records a NodeCreatedV1\nevent in the Node’s DomainEvents collection.\n\nNodeCreatedV1 schema:\n- NodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nThe event announces that Graph created a Node and identifies\nits external Content and Participant references.\n\nThe event has only been recorded. It has not yet been\npublished or delivered to subscribers.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"As part of Node construction, Graph records a NodeCreatedV1 event in the Node’s DomainEvents collection.\n\nNodeCreatedV1 schema:\n- NodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nThe event announces that Graph created a Node and identifies its external Content and Participant references.\n\nThe event has only been recorded. It has not yet been published or delivered to subscribers.","autoResize":false,"lineHeight":1.25},{"id":"lRGRPZrSMuUkRRL4yxDRc","type":"rectangle","x":989.1515926627605,"y":-1591.2093012559362,"width":643.110003603378,"height":568.1347989670317,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["-jjlVUJtpVEvgg6PZCQlb","XYEMSNn2O63xDknEu5Ai-","aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6P","roundness":{"type":3},"seed":1138012340,"version":2497,"versionNonce":640494220,"isDeleted":false,"boundElements":[{"id":"szjMlLXyeJptQu2RXROM3","type":"arrow"},{"id":"9oFzTE6f9__5pyTtSw8HN","type":"arrow"}],"updated":1788984150916,"link":null,"locked":false},{"id":"VGXNtHqeANvNavHFWfXlB","type":"text","x":1008.6143149539598,"y":-1570.2049760984235,"width":664.9486631114165,"height":32.8558121537879,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["XYEMSNn2O63xDknEu5Ai-","aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6Q","roundness":null,"seed":1826912820,"version":1028,"versionNonce":17180172,"isDeleted":false,"boundElements":[],"updated":1788984150916,"link":null,"locked":false,"text":"9. Add Parent relationship (Optional)","fontSize":26.284649723030324,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"9. Add Parent relationship (Optional)","autoResize":false,"lineHeight":1.25},{"id":"hjYY7Hitnf3yGMb9pt95R","type":"text","x":1018.9350197821531,"y":-1534.553938281264,"width":594.0536499023438,"height":495,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6R","roundness":null,"seed":914622004,"version":565,"versionNonce":200115340,"isDeleted":false,"boundElements":null,"updated":1788984150916,"link":null,"locked":false,"text":"This step occurs only when creating a sub-node.\n\nThe Console Host calls:\n\nnode.AttachToParent(parent.Id, now)\n\nGraph:\n- Rejects an empty parent ID\n- Prevents the Node from being its own parent\n- Ignores a parent already attached\n- Adds the ParentNodeId\n- Updates UpdatedAt\n- Records NodeParentAttachedV1\n\nNodeParentAttachedV1 schema:\n- NodeId\n- ParentNodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nBoth creation events remain recorded on the Node until publication.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"This step occurs only when creating a sub-node.\n\nThe Console Host calls:\n\nnode.AttachToParent(parent.Id, now)\n\nGraph:\n- Rejects an empty parent ID\n- Prevents the Node from being its own parent\n- Ignores a parent already attached\n- Adds the ParentNodeId\n- Updates UpdatedAt\n- Records NodeParentAttachedV1\n\nNodeParentAttachedV1 schema:\n- NodeId\n- ParentNodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nBoth creation events remain recorded on the Node until publication.","autoResize":true,"lineHeight":1.25},{"id":"szjMlLXyeJptQu2RXROM3","type":"arrow","x":1500.9050979215351,"y":-852.097436811605,"width":57.86417827644641,"height":160.29059852280886,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6S","roundness":{"type":2},"seed":592119092,"version":257,"versionNonce":1858074892,"isDeleted":false,"boundElements":null,"updated":1788984150916,"link":null,"locked":false,"points":[[0,0],[-57.86417827644641,-160.29059852280886]],"lastCommittedPoint":null,"startBinding":{"elementId":"graph_boundary","focus":0.1372144691805041,"gap":5.649807965387413},"endBinding":{"elementId":"lRGRPZrSMuUkRRL4yxDRc","focus":-0.0550899257908527,"gap":16.08442790411368},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"9oFzTE6f9__5pyTtSw8HN","type":"arrow","x":1395.1473906515225,"y":-1013.966097554535,"width":48.78815311930725,"height":176.07199064755298,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6T","roundness":{"type":2},"seed":60707468,"version":255,"versionNonce":1760884620,"isDeleted":false,"boundElements":null,"updated":1788984150916,"link":null,"locked":false,"points":[[0,0],[48.78815311930725,176.07199064755298]],"lastCommittedPoint":null,"startBinding":{"elementId":"lRGRPZrSMuUkRRL4yxDRc","focus":-0.001982068172937703,"gap":13.716016501907689},"endBinding":{"elementId":"graph_boundary","focus":-0.06012231445296785,"gap":1},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"J4_1oAoIMyKUueblXlTj9","type":"text","x":265.0682475772278,"y":-915.9085034829917,"width":855.449462890625,"height":472.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["wfwEkQqoVcsjybzjigF_5","Vz0FUbDrvxtrLGY9dqt_l"],"frameId":null,"index":"b6U","roundness":null,"seed":251909644,"version":187,"versionNonce":501659916,"isDeleted":false,"boundElements":null,"updated":1788984234243,"link":null,"locked":false,"text":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","autoResize":true,"lineHeight":1.25},{"id":"l015KsdUu3j96JvMivpuw","type":"text","x":1965.177046954202,"y":1294.6162360958126,"width":795.0955810546875,"height":337.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["2N0YrrKABRDRF_DpMmIzx","7F0Cp9XuYUQT25XcV8P3f"],"frameId":null,"index":"b6V","roundness":null,"seed":502553612,"version":90,"versionNonce":134630452,"isDeleted":false,"boundElements":null,"updated":1788984342402,"link":null,"locked":false,"text":"After the Node is successfully saved, the Console Host loops through node.DomainEvents.\n\nEach recorded event is passed to:\n\neventPublisher.Publish(domainEvent)\n\nThe in-memory Event Bus:\n- Identifies the event type\n- Finds handlers registered for that exact type\n- Invokes each handler synchronously\n- Reports how many subscribers received it\n\nA root Node normally publishes NodeCreatedV1.\n\nA new sub-node may also publish NodeParentAttachedV1.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"After the Node is successfully saved, the Console Host loops through node.DomainEvents.\n\nEach recorded event is passed to:\n\neventPublisher.Publish(domainEvent)\n\nThe in-memory Event Bus:\n- Identifies the event type\n- Finds handlers registered for that exact type\n- Invokes each handler synchronously\n- Reports how many subscribers received it\n\nA root Node normally publishes NodeCreatedV1.\n\nA new sub-node may also publish NodeParentAttachedV1.","autoResize":true,"lineHeight":1.25},{"id":"eZYPoeuBWkUuUItVz9R0x","type":"text","x":755.6316995975765,"y":2304.1450117039976,"width":1027.295654296875,"height":292.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["CwChNFPisWrnziYKjpaW5","sZW25L3F6l0U75RnzJDnu"],"frameId":null,"index":"b6W","roundness":null,"seed":474665228,"version":312,"versionNonce":1100531252,"isDeleted":false,"boundElements":[{"id":"tCIX_-Wsm9qvU-O-Jic5d","type":"arrow"}],"updated":1788984904607,"link":null,"locked":false,"text":"The Event Bus delivers NodeCreatedV1 to Content’s registered handler:\n\nObserveNodeLifecycleInContent.Handle(message)\n\nContent reads DescriptionId from the event and searches its repository for the referenced Document.\n\nIf found, Content confirms that the description Document exists.\n\nIf missing, Content reports that the reference could not be resolved.\n\nContent does not create the Document here. The Document was created and saved before Graph created the Node.\n\nNo event is currently sent back from Content to Graph.","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Event Bus delivers NodeCreatedV1 to Content’s registered handler:\n\nObserveNodeLifecycleInContent.Handle(message)\n\nContent reads DescriptionId from the event and searches its repository for the referenced Document.\n\nIf found, Content confirms that the description Document exists.\n\nIf missing, Content reports that the reference could not be resolved.\n\nContent does not create the Document here. The Document was created and saved before Graph created the Node.\n\nNo event is currently sent back from Content to Graph.","autoResize":true,"lineHeight":1.25},{"id":"HQXCmTuI6Y8XhkpLfhtK7","type":"arrow","x":1913.502801747004,"y":1317.9036752954585,"width":577.6219759721487,"height":910.0266962417386,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6X","roundness":{"type":2},"seed":240292660,"version":176,"versionNonce":1880030476,"isDeleted":false,"boundElements":[],"updated":1788984446794,"link":null,"locked":false,"points":[[0,0],[-459.8461491085013,430.9644630965877],[-577.6219759721487,910.0266962417386]],"lastCommittedPoint":null,"startBinding":{"elementId":"FDrSShOKFsWyaYcKuw4v0","focus":0.8872595117446237,"gap":16.780655763172035},"endBinding":{"elementId":"8eR0XZgmsUj7iHYP-gijv","focus":0.03756307531709903,"gap":10.726069112219193},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"tCIX_-Wsm9qvU-O-Jic5d","type":"arrow","x":1339.8021029661866,"y":2610.645011703998,"width":1144.294860244893,"height":625.4894300350029,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6Z","roundness":{"type":2},"seed":1908636556,"version":180,"versionNonce":909574028,"isDeleted":false,"boundElements":[],"updated":1788984904609,"link":null,"locked":false,"points":[[0,0],[446.2381410426249,432.8055291158594],[1144.294860244893,625.4894300350029]],"lastCommittedPoint":null,"startBinding":{"elementId":"eZYPoeuBWkUuUItVz9R0x","focus":0.1425281621146477,"gap":14},"endBinding":{"elementId":"content_boundary","focus":0.04099180941479583,"gap":23.090270783849892},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"olbyNHknyP0UxBdBBrQfi","type":"text","x":4149.304564800269,"y":1942.101460478612,"width":978.1159077291269,"height":371.54264755392074,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["MLMdWAAVrpgEryQhHHGMS","FYaASLbX2oIST9tRVmpYO"],"frameId":null,"index":"b6a","roundness":null,"seed":1729900980,"version":232,"versionNonce":1819739060,"isDeleted":false,"boundElements":null,"updated":1788984678844,"link":null,"locked":false,"text":"After event publication returns, the Console Host calls:\n\nnode.ClearDomainEvents()\n\nGraph removes the dispatched events from the Node’s in-memory \nDomainEvents collection.\n\nThis prevents the same NodeCreatedV1 or NodeParentAttachedV1 events \nfrom being published again from this Node instance.\n\nClearing the events does not alter the persisted Node or Document.","fontSize":27.021283458466964,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"After event publication returns, the Console Host calls:\n\nnode.ClearDomainEvents()\n\nGraph removes the dispatched events from the Node’s in-memory \nDomainEvents collection.\n\nThis prevents the same NodeCreatedV1 or NodeParentAttachedV1 events \nfrom being published again from this Node instance.\n\nClearing the events does not alter the persisted Node or Document.","autoResize":true,"lineHeight":1.25},{"id":"gap_event_kind","type":"diamond","x":1425.2494977941883,"y":2707.3395689854224,"width":720.4808445419885,"height":661.8707097079432,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#fff5f5","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["uTf4VnQVyqOTFDBLtSRv2","hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6b","roundness":null,"seed":2035266621,"version":1113,"versionNonce":325178124,"isDeleted":false,"boundElements":[],"updated":1788984921243,"link":null,"locked":false},{"id":"gap_event_kind_t","type":"text","x":1533.7714498862285,"y":2928.720859759624,"width":521.587890625,"height":345,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["uTf4VnQVyqOTFDBLtSRv2","hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6c","roundness":null,"seed":202222282,"version":770,"versionNonce":273387916,"isDeleted":false,"boundElements":[],"updated":1788984921243,"link":null,"locked":false,"fontSize":23,"fontFamily":2,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"The Document is saved before the \nNode is created and saved.\n\nIf Node creation or Node persistence fails after the \nDocument is saved, documents.json may retain an \norphaned Document with no \nNode referencing it.\n\nThe current prototype does \nnot yet provide rollback, \ncompensation, \nor orphan cleanup.","autoResize":true,"lineHeight":1.25,"text":"The Document is saved before the \nNode is created and saved.\n\nIf Node creation or Node persistence fails after the \nDocument is saved, documents.json may retain an \norphaned Document with no \nNode referencing it.\n\nThe current prototype does \nnot yet provide rollback, \ncompensation, \nor orphan cleanup."},{"id":"zSGrLj6Dy7YQzwpfVHd9U","type":"text","x":1653.9801832095868,"y":2842.6071064384046,"width":230.72885131835938,"height":55.992601887352095,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6d","roundness":null,"seed":2120052108,"version":281,"versionNonce":1987674124,"isDeleted":false,"boundElements":null,"updated":1788984921243,"link":null,"locked":false,"text":"CURRENT FAILURE \nGAP","fontSize":22.39704075494084,"fontFamily":5,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"CURRENT FAILURE \nGAP","autoResize":true,"lineHeight":1.25},{"id":"GVVPartQJDoQpt5UZWKwj","type":"text","x":2446.3087490819826,"y":-763.650700263921,"width":1394.7769978959705,"height":437.0001220703125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["NgGulhikHcyM3zVD8YQrb"],"frameId":null,"index":"b6f","roundness":null,"seed":1659862580,"version":603,"versionNonce":862878516,"isDeleted":false,"boundElements":[],"updated":1788985114279,"link":null,"locked":false,"text":"Node Creation \nWorkflow","fontSize":174.800048828125,"fontFamily":5,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"Node Creation \nWorkflow","autoResize":false,"lineHeight":1.25}],"appState":{"currentItemStrokeColor":"#1e1e1e","currentItemBackgroundColor":"#ffffff","currentItemFillStyle":"solid","currentItemStrokeWidth":1,"currentItemStrokeStyle":"solid","currentItemRoughness":1,"currentItemOpacity":100,"currentItemFontFamily":5,"currentItemFontSize":130,"currentItemTextAlign":"center","currentItemStartArrowhead":null,"currentItemEndArrowhead":"arrow","scrollX":1551.105296805049,"scrollY":2278.6569519335817,"zoom":{"value":0.1},"currentItemRoundness":"round","gridSize":20,"frameRendering":{"enabled":true,"clip":true,"name":true,"outline":true},"objectsSnapModeEnabled":false},"files":{}}