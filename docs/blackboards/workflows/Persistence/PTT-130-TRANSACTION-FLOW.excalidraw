      "roundness": null,
      "seed": 46,
      "version": 1,
      "versionNonce": 46,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791720000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Same connection string required across repositories; different strings are rejected.\n\u2022 Named lock: Exclusive, Transaction-owned, timeout 15 seconds, one name for creation and parent changes.\n\u2022 Default context factory uses host-configured SqlStorage; tests may inject a factory.\n\u2022 Synchronous scope only: no parallel use of shared EF context.\n\u2022 Standalone save opens its own boundary; it cannot group earlier independent saves.\n\u2022 SQL rollback does not undo domain objects in memory or external event delivery.",
      "originalText": "\u2022 Same connection string required across repositories; different strings are rejected.\n\u2022 Named lock: Exclusive, Transaction-owned, timeout 15 seconds, one name for creation and parent changes.\n\u2022 Default context factory uses host-configured SqlStorage; tests may inject a factory.\n\u2022 Synchronous scope only: no parallel use of shared EF context.\n\u2022 Standalone save opens its own boundary; it cannot group earlier independent saves.\n\u2022 SQL rollback does not undo domain objects in memory or external event delivery.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    }
