    {
      "id": "ptt130-46",
      "type": "text",
      "x": 40,
      "y": 1390,
      "width": 907.8,
      "height": 127.5,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
