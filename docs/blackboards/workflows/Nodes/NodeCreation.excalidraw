522.7114309440537,"y":-312.6616215529307,"width":197.6730318586943,"height":121.22381318597665,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["wfwEkQqoVcsjybzjigF_5","Vz0FUbDrvxtrLGY9dqt_l"],"frameId":null,"index":"b77","roundness":{"type":3},"seed":193316364,"version":2818,"versionNonce":924394518,"isDeleted":false,"boundElements":[{"id":"5Y2tmy-7fMkyQ1HERSis5","type":"arrow"}],"updated":1789008916397,"link":null,"locked":false},{"id":"q5rqFXgxoC8nJK5vf-yZY","type":"text","x":-503.4189567860651,"y":-308.8100281970484,"width":124.41980399471538,"height":13.809762955037828,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["Vz0FUbDrvxtrLGY9dqt_l"],"frameId":null,"index":"b78","roundness":null,"seed":377271052,"version":1375,"versionNonce":1032540234,"isDeleted":false,"boundElements":[],"updated":1789008916397,"link":"https://github.com/williamowen65/atlas-the-public-think-tank/blob/PTT-68-Discover-current-boundary-coverage-and-architecture-gaps/src/Atlas.Console/Storage/JsonNodeRepository.cs#L54-L72","locked":false,"text":"10. Graph saves node","fontSize":11.047810364030264,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"10. Graph saves node","autoResize":false,"lineHeight":1.25},{"id":"J4_1oAoIMyKUueblXlTj9","type":"text","x":-508.46839677063235,"y":-294.73858279859246,"width":176.28038657712747,"height":97.36692378792489,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["wfwEkQqoVcsjybzjigF_5","Vz0FUbDrvxtrLGY9dqt_l"],"frameId":null,"index":"b79","roundness":null,"seed":251909644,"version":676,"versionNonce":801648982,"isDeleted":false,"boundElements":[{"id":"tg2dpu54ydgAQX2_kRSgn","type":"arrow"}],"updated":1789008916397,"link":null,"locked":false,"text":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","fontSize":3.709216144301901,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","autoResize":true,"lineHeight":1.25}],"appState":{"currentItemStrokeColor":"#1e1e1e","currentItemBackgroundColor":"#ffffff","currentItemFillStyle":"solid","currentItemStrokeWidth":1,"currentItemStrokeStyle":"solid","currentItemRoughness":1,"currentItemOpacity":100,"currentItemFontFamily":5,"currentItemFontSize":41,"currentItemTextAlign":"center","currentItemStartArrowhead":null,"currentItemEndArrowhead":"arrow","scrollX":749.6781038623608,"scrollY":-149.45440419460326,"zoom":{"value":1.002722},"currentItemRoundness":"round","gridSize":20,"frameRendering":{"enabled":true,"clip":true,"name":true,"outline":true},"objectsSnapModeEnabled":false},"files":{}}