ngle","x":254.81915784455964,"y":-766.2225432971062,"width":180.23150231467923,"height":89.38281558363023,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["IEYQ3qvLmPbON74NLkLlx","cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b61","roundness":{"type":3},"seed":1057842700,"version":2609,"versionNonce":51642122,"isDeleted":false,"boundElements":[],"updated":1789008235262,"link":null,"locked":false},{"id":"JLRejsZmUtO7lkOK_vVxd","type":"text","x":262.0959582509096,"y":-761.8654017509584,"width":153.3508956246175,"height":13.757892682576914,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b62","roundness":null,"seed":482184076,"version":723,"versionNonce":185830858,"isDeleted":false,"boundElements":null,"updated":1789008235262,"link":"https://github.com/williamowen65/atlas-the-public-think-tank/blob/PTT-68-Discover-current-boundary-coverage-and-architecture-gaps/src/Atlas.Console/ConsoleApplication.cs#L279-L290","locked":false,"text":"1. User starts node creation","fontSize":11.00631414606154,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. User starts node creation","autoResize":true,"lineHeight":1.25},{"id":"9iJBLAUExzKtvWIAhPwOd","type":"text","x":262.81186446163076,"y":-744.6106737476359,"width":145.91348801083004,"height":60.28656614310854,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["IEYQ3qvLmPbON74NLkLlx","cm5xhIFSWtIorrLGb1JON"],"frameId":null,"index":"b63","roundness":null,"seed":279641484,"version":359,"versionNonce":177350742,"isDeleted":false,"boundElements":[{"id":"0brxqnrbH-Mbw099X2R0E","type":"arrow"}],"updated":1789008235291,"link":null,"locked":false,"text":"The selected Participant chooses “Create node” from the Console menu.\n\nConsoleApplication.CreateNode() starts the shared NodeCreationWorkflow.\n\nThe workflow receives:\n- Node repository\n- Node type repository\n- Document repository\n- Current Participant\n- Event publisher\n\nNo domain objects have been created yet.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The selected Participant chooses “Create node” from the Console menu.\n\nConsoleApplication.CreateNode() starts the shared NodeCreationWorkflow.\n\nThe workflow receives:\n- Node repository\n- Node type repository\n- Document repository\n- Current Participant\n- Event publisher\n\nNo domain objects have been created yet.","autoResize":true,"lineHeight":1.25},{"id":"C3eYjQMI_MOyBk6zlPnRi","type":"text","x":-243.49100886266956,"y":-678.5688129759523,"width":226.11872372387649,"height":90.4298492146628,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["W5kpz8RCuhNM9ZfJeAIKn"],"frameId":null,"index":"b64","roundness":null,"seed":402715060,"version":364,"versionNonce":1888220886,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"text":"The Console Host constructs a new Graph Node.\n\nGraph generates:\n- A new NodeId\n- Active status\n- CreatedAt and UpdatedAt timestamps\n\nGraph stores:\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- Requested sub-node type IDs\n- Parent node IDs, initially empty\n\nThe DescriptionId is a reference to Content’s Document. The Node does not contain or own the description text.\n\nThe Node now exists in memory but has not yet been persisted.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host constructs a new Graph Node.\n\nGraph generates:\n- A new NodeId\n- Active status\n- CreatedAt and UpdatedAt timestamps\n\nGraph stores:\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- Requested sub-node type IDs\n- Parent node IDs, initially empty\n\nThe DescriptionId is a reference to Content’s Document. The Node does not contain or own the description text.\n\nThe Node now exists in memory but has not yet been persisted.","autoResize":true,"lineHeight":1.25},{"id":"32zMlvPpcJiqcFixq9fbq","type":"text","x":191.38496034866205,"y":-51.32055424151804,"width":218.05235915084126,"height":70.33432716695995,"angle":0.00003249305688157733,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["saDZwJ26qyYrnuUSe2qxX"],"frameId":null,"index":"b65","roundness":null,"seed":1431942324,"version":332,"versionNonce":1122811926,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"text":"The Console Host calls:\n\ndocuments.Save(document)\n\nThe Content repository converts the Document into a StoredDocument and writes it to data/documents.json.\n\nStored document schema:\n- Id\n- Content\n- CreatedAt\n\nIf the ID already exists, the repository replaces that record. Otherwise, it adds a new record.\n\nThe description is now persistent, but the Graph Node has not been created yet.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host calls:\n\ndocuments.Save(document)\n\nThe Content repository converts the Document into a StoredDocument and writes it to data/documents.json.\n\nStored document schema:\n- Id\n- Content\n- CreatedAt\n\nIf the ID already exists, the repository replaces that record. Otherwise, it adds a new record.\n\nThe description is now persistent, but the Graph Node has not been created yet.","autoResize":true,"lineHeight":1.25},{"id":"WxXtRXPPqFJfiHg1r1S2E","type":"text","x":-124.73136435394952,"y":-213.87671994572145,"width":177.1097772008602,"height":75.35820767888568,"angle":0.00003249305688157733,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["BwKUADk94kGiAIHv71UQB"],"frameId":null,"index":"b66","roundness":null,"seed":836878988,"version":463,"versionNonce":2015271562,"isDeleted":false,"boundElements":null,"updated":1789008235262,"link":null,"locked":false,"text":"Content returns the created Document, including its DocumentId, to the Console Host.\n\nThe Console Host converts the Content-owned identifier into Graph’s reference type:\n\nnew NodeDescriptionId(document.Id.Value)\n\nThe Console Host then supplies Graph with:\n- NodeTitle\n- NodeDescriptionId\n- NodeTypeId\n- NodeAuthorId\n- Requested sub-node type IDs\n- Creation timestamp\n\nThe description text does not cross into Graph. Only its identifier crosses the boundary.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Content returns the created Document, including its DocumentId, to the Console Host.\n\nThe Console Host converts the Content-owned identifier into Graph’s reference type:\n\nnew NodeDescriptionId(document.Id.Value)\n\nThe Console Host then supplies Graph with:\n- NodeTitle\n- NodeDescriptionId\n- NodeTypeId\n- NodeAuthorId\n- Requested sub-node type IDs\n- Creation timestamp\n\nThe description text does not cross into Graph. Only its identifier crosses the boundary.","autoResize":true,"lineHeight":1.25},{"id":"6Pap3FO0WiggBSbzccZWc","type":"text","x":-462.13809443657595,"y":-699.4448860621249,"width":125.78144090672872,"height":70.33432716695995,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["F1itjXOWTY8NqLSU3bU-k","QZSHvYK5cSU2KsEuWhw4m"],"frameId":null,"index":"b67","roundness":null,"seed":439884596,"version":651,"versionNonce":1262401866,"isDeleted":false,"boundElements":null,"updated":1789008235262,"link":null,"locked":false,"text":"As part of Node construction, Graph records a NodeCreatedV1\nevent in the Node’s DomainEvents collection.\n\nNodeCreatedV1 schema:\n- NodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nThe event announces that Graph created a Node and identifies\nits external Content and Participant references.\n\nThe event has only been recorded. It has not yet been\npublished or delivered to subscribers.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"As part of Node construction, Graph records a NodeCreatedV1 event in the Node’s DomainEvents collection.\n\nNodeCreatedV1 schema:\n- NodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nThe event announces that Graph created a Node and identifies its external Content and Participant references.\n\nThe event has only been recorded. It has not yet been published or delivered to subscribers.","autoResize":false,"lineHeight":1.25},{"id":"lRGRPZrSMuUkRRL4yxDRc","type":"rectangle","x":-365.5397798478407,"y":-1065.849409959912,"width":143.59590285011043,"height":126.85517087454676,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["-jjlVUJtpVEvgg6PZCQlb","XYEMSNn2O63xDknEu5Ai-","aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6P","roundness":{"type":3},"seed":1138012340,"version":2774,"versionNonce":1785528330,"isDeleted":false,"boundElements":[{"id":"szjMlLXyeJptQu2RXROM3","type":"arrow"},{"id":"9oFzTE6f9__5pyTtSw8HN","type":"arrow"}],"updated":1789008235262,"link":null,"locked":false},{"id":"VGXNtHqeANvNavHFWfXlB","type":"text","x":-361.19407357105024,"y":-1061.159489078802,"width":148.47211689051113,"height":7.336163305906977,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["XYEMSNn2O63xDknEu5Ai-","aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6Q","roundness":null,"seed":1826912820,"version":1305,"versionNonce":523945034,"isDeleted":false,"boundElements":[],"updated":1789008235262,"link":"https://github.com/williamowen65/atlas-the-public-think-tank/blob/PTT-68-Discover-current-boundary-coverage-and-architecture-gaps/src/Atlas.Graph/Node.cs#L244-L264","locked":false,"text":"9. Add Parent relationship (Optional)","fontSize":5.868930644725581,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"9. Add Parent relationship (Optional)","autoResize":false,"lineHeight":1.25},{"id":"hjYY7Hitnf3yGMb9pt95R","type":"text","x":-358.88962966635273,"y":-1053.1991977845994,"width":132.64242465700994,"height":110.52537126236564,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["aph0E3RyUfezQjiwXWMrr"],"frameId":null,"index":"b6R","roundness":null,"seed":914622004,"version":846,"versionNonce":414165770,"isDeleted":false,"boundElements":[{"id":"szjMlLXyeJptQu2RXROM3","type":"arrow"},{"id":"9oFzTE6f9__5pyTtSw8HN","type":"arrow"}],"updated":1789008235262,"link":null,"locked":false,"text":"This step occurs only when creating a sub-node.\n\nThe Console Host calls:\n\nnode.AttachToParent(parent.Id, now)\n\nGraph:\n- Rejects an empty parent ID\n- Prevents the Node from being its own parent\n- Ignores a parent already attached\n- Adds the ParentNodeId\n- Updates UpdatedAt\n- Records NodeParentAttachedV1\n\nNodeParentAttachedV1 schema:\n- NodeId\n- ParentNodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nBoth creation events remain recorded on the Node until publication.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"This step occurs only when creating a sub-node.\n\nThe Console Host calls:\n\nnode.AttachToParent(parent.Id, now)\n\nGraph:\n- Rejects an empty parent ID\n- Prevents the Node from being its own parent\n- Ignores a parent already attached\n- Adds the ParentNodeId\n- Updates UpdatedAt\n- Records NodeParentAttachedV1\n\nNodeParentAttachedV1 schema:\n- NodeId\n- ParentNodeId\n- DescriptionId\n- AuthorId\n- OccurredAt\n\nBoth creation events remain recorded on the Node until publication.","autoResize":true,"lineHeight":1.25},{"id":"szjMlLXyeJptQu2RXROM3","type":"arrow","x":-251.67388559433783,"y":-900.7795474727556,"width":12.910380818129173,"height":35.828579031542915,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6S","roundness":{"type":2},"seed":592119092,"version":1102,"versionNonce":330436374,"isDeleted":false,"boundElements":null,"updated":1789008235291,"link":null,"locked":false,"points":[[0,0],[-12.910380818129173,-35.828579031542915]],"lastCommittedPoint":null,"startBinding":null,"endBinding":{"elementId":"hjYY7Hitnf3yGMb9pt95R","focus":-0.06824690947745211,"gap":6.065700017935228},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"9oFzTE6f9__5pyTtSw8HN","type":"arrow","x":-275.2935904119835,"y":-936.9604818835996,"width":10.877000940678553,"height":39.417663607688745,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6T","roundness":{"type":2},"seed":60707468,"version":1101,"versionNonce":1014832854,"isDeleted":false,"boundElements":null,"updated":1789008235291,"link":null,"locked":false,"points":[[0,0],[10.877000940678553,39.417663607688745]],"lastCommittedPoint":null,"startBinding":null,"endBinding":{"elementId":"hjYY7Hitnf3yGMb9pt95R","focus":0,"gap":14},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"J4_1oAoIMyKUueblXlTj9","type":"text","x":-527.2157001316266,"y":-915.0658313990507,"width":191.00781713571234,"height":105.50149075043993,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["wfwEkQqoVcsjybzjigF_5","Vz0FUbDrvxtrLGY9dqt_l"],"frameId":null,"index":"b6U","roundness":null,"seed":251909644,"version":472,"versionNonce":1147065366,"isDeleted":false,"boundElements":[{"id":"tg2dpu54ydgAQX2_kRSgn","type":"arrow"}],"updated":1789008235291,"link":null,"locked":false,"text":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","fontSize":4.01910440954057,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Console Host calls:\n\nnodes.Save(node)\n\nThe Graph repository converts the Node into a StoredNode and writes it to data/nodes.json.\n\nStored node schema:\n- Id\n- Title\n- DescriptionId\n- TypeId\n- AuthorId\n- RequestedSubNodeTypeIds\n- ParentNodeIds\n- Status\n- CreatedAt\n- UpdatedAt\n\nThe stored Node contains the DescriptionId reference, not the Content-owned description text.\n\nThe Node is saved before any recorded events are published.","autoResize":true,"lineHeight":1.25},{"id":"l015KsdUu3j96JvMivpuw","type":"text","x":-147.60932389414245,"y":-421.4919576079569,"width":177.53178643461752,"height":75.35820767888568,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["2N0YrrKABRDRF_DpMmIzx","7F0Cp9XuYUQT25XcV8P3f"],"frameId":null,"index":"b6V","roundness":null,"seed":502553612,"version":373,"versionNonce":1497540758,"isDeleted":false,"boundElements":[{"id":"HQXCmTuI6Y8XhkpLfhtK7","type":"arrow"}],"updated":1789008235291,"link":null,"locked":false,"text":"After the Node is successfully saved, the Console Host loops through node.DomainEvents.\n\nEach recorded event is passed to:\n\neventPublisher.Publish(domainEvent)\n\nThe in-memory Event Bus:\n- Identifies the event type\n- Finds handlers registered for that exact type\n- Invokes each handler synchronously\n- Reports how many subscribers received it\n\nA root Node normally publishes NodeCreatedV1.\n\nA new sub-node may also publish NodeParentAttachedV1.","fontSize":4.01910440954057,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"After the Node is successfully saved, the Console Host loops through node.DomainEvents.\n\nEach recorded event is passed to:\n\neventPublisher.Publish(domainEvent)\n\nThe in-memory Event Bus:\n- Identifies the event type\n- Finds handlers registered for that exact type\n- Invokes each handler synchronously\n- Reports how many subscribers received it\n\nA root Node normally publishes NodeCreatedV1.\n\nA new sub-node may also publish NodeParentAttachedV1.","autoResize":true,"lineHeight":1.25},{"id":"eZYPoeuBWkUuUItVz9R0x","type":"text","x":-417.68093717749167,"y":-196.08076018545978,"width":229.37824967146855,"height":65.31044665503426,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["CwChNFPisWrnziYKjpaW5","sZW25L3F6l0U75RnzJDnu"],"frameId":null,"index":"b6W","roundness":null,"seed":474665228,"version":591,"versionNonce":761703434,"isDeleted":false,"boundElements":[{"id":"tCIX_-Wsm9qvU-O-Jic5d","type":"arrow"}],"updated":1789008235262,"link":null,"locked":false,"text":"The Event Bus delivers NodeCreatedV1 to Content’s registered handler:\n\nObserveNodeLifecycleInContent.Handle(message)\n\nContent reads DescriptionId from the event and searches its repository for the referenced Document.\n\nIf found, Content confirms that the description Document exists.\n\nIf missing, Content reports that the reference could not be resolved.\n\nContent does not create the Document here. The Document was created and saved before Graph created the Node.\n\nNo event is currently sent back from Content to Graph.","fontSize":4.019104409540569,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The Event Bus delivers NodeCreatedV1 to Content’s registered handler:\n\nObserveNodeLifecycleInContent.Handle(message)\n\nContent reads DescriptionId from the event and searches its repository for the referenced Document.\n\nIf found, Content confirms that the description Document exists.\n\nIf missing, Content reports that the reference could not be resolved.\n\nContent does not create the Document here. The Document was created and saved before Graph created the Node.\n\nNo event is currently sent back from Content to Graph.","autoResize":true,"lineHeight":1.25},{"id":"HQXCmTuI6Y8XhkpLfhtK7","type":"arrow","x":-158.75360648676246,"y":-416.6612536661403,"width":129.75456264086122,"height":205.1385232918066,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6X","roundness":{"type":2},"seed":240292660,"version":1025,"versionNonce":1295861398,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"points":[[0,0],[-103.06982142761062,96.59628625601586],[-129.75456264086122,205.1385232918066]],"lastCommittedPoint":null,"startBinding":{"elementId":"l015KsdUu3j96JvMivpuw","focus":1.0464436453215118,"gap":11.144282592620016},"endBinding":{"elementId":"N2lPZWpHerAhPXqKpi1h7","focus":-2.6545965414947923,"gap":14},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"tCIX_-Wsm9qvU-O-Jic5d","type":"arrow","x":-287.24527917183207,"y":-127.64434343411574,"width":255.5022510347144,"height":139.66151813192752,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b6Z","roundness":{"type":2},"seed":1908636556,"version":1004,"versionNonce":973150486,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"points":[[0,0],[99.63764890942223,96.63836725239386],[255.5022510347144,139.66151813192752]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"olbyNHknyP0UxBdBBrQfi","type":"text","x":340.07048377108185,"y":-276.9191398063306,"width":218.39721987755055,"height":82.95937183979669,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["MLMdWAAVrpgEryQhHHGMS","FYaASLbX2oIST9tRVmpYO"],"frameId":null,"index":"b6a","roundness":null,"seed":1729900980,"version":515,"versionNonce":1033092246,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"text":"After event publication returns, the Console Host calls:\n\nnode.ClearDomainEvents()\n\nGraph removes the dispatched events from the Node’s in-memory \nDomainEvents collection.\n\nThis prevents the same NodeCreatedV1 or NodeParentAttachedV1 events \nfrom being published again from this Node instance.\n\nClearing the events does not alter the persisted Node or Document.","fontSize":6.033408861076123,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"After event publication returns, the Console Host calls:\n\nnode.ClearDomainEvents()\n\nGraph removes the dispatched events from the Node’s in-memory \nDomainEvents collection.\n\nThis prevents the same NodeCreatedV1 or NodeParentAttachedV1 events \nfrom being published again from this Node instance.\n\nClearing the events does not alter the persisted Node or Document.","autoResize":true,"lineHeight":1.25},{"id":"gap_event_kind","type":"diamond","x":-268.16627909755573,"y":-106.05403668143015,"width":160.87154107156772,"height":147.7848604407189,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#fff5f5","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["uTf4VnQVyqOTFDBLtSRv2","hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6b","roundness":null,"seed":2035266621,"version":1390,"versionNonce":1143765834,"isDeleted":false,"boundElements":[],"updated":1789008235262,"link":null,"locked":false},{"id":"gap_event_kind_t","type":"text","x":-243.9351093094961,"y":-56.62322990696475,"width":116.4620106207723,"height":77.03283451619423,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["uTf4VnQVyqOTFDBLtSRv2","hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6c","roundness":null,"seed":202222282,"version":1049,"versionNonce":416435094,"isDeleted":false,"boundElements":[],"updated":1789008235291,"link":null,"locked":false,"fontSize":5.135522301079616,"fontFamily":2,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"The Document is saved before the \nNode is created and saved.\n\nIf Node creation or Node persistence fails after the \nDocument is saved, documents.json may retain an \norphaned Document with no \nNode referencing it.\n\nThe current prototype does \nnot yet provide rollback, \ncompensation, \nor orphan cleanup.","autoResize":true,"lineHeight":1.25,"text":"The Document is saved before the \nNode is created and saved.\n\nIf Node creation or Node persistence fails after the \nDocument is saved, documents.json may retain an \norphaned Document with no \nNode referencing it.\n\nThe current prototype does \nnot yet provide rollback, \ncompensation, \nor orphan cleanup."},{"id":"zSGrLj6Dy7YQzwpfVHd9U","type":"text","x":-217.0944731892077,"y":-75.8510168900425,"width":51.5179635412138,"height":12.502228508172577,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["hwsw_QtB0DPckOK2v4YPj"],"frameId":null,"index":"b6d","roundness":null,"seed":2120052108,"version":558,"versionNonce":560793482,"isDeleted":false,"boundElements":null,"updated":1789008235262,"link":null,"locked":false,"text":"CURRENT FAILURE \nGAP","fontSize":5.000891403269031,"fontFamily":5,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"CURRENT FAILURE \nGAP","autoResize":true,"lineHeight":1.25},{"id":"GVVPartQJDoQpt5UZWKwj","type":"text","x":-40.18051580572467,"y":-828.3742261622192,"width":311.43079903163624,"height":97.57495097680888,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["NgGulhikHcyM3zVD8YQrb"],"frameId":null,"index":"b6f","roundness":null,"seed":1659862580,"version":898,"versionNonce":2050459210,"isDeleted":false,"boundElements":[],"updated":1789008235262,"link":null,"locked":false,"text":"Node Creation \nWorkflow","fontSize":39.02998039072356,"fontFamily":5,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"Node Creation \nWorkflow","autoResize":false,"lineHeight":1.25},{"id":"D5_5j8k50E2to1aFsF9Ca","type":"rectangle","x":418.5863790083631,"y":-1080.7850356372808,"width":97.27036000965319,"height":17.080761335837856,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#1e1e1e","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["VIRTAP6Sq8XtpGwXuo2bN"],"frameId":null,"index":"b6m","roundness":{"type":3},"seed":460909236,"version":424,"ver