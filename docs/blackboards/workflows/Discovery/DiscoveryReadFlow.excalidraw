    {
      "id": "pagination-note",
      "type": "text",
      "x": 60,
      "y": 1390,
      "width": 732.875,
      "height": 237.5,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 38,
      "version": 2,
      "versionNonce": 48,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791927385490,
      "link": null,
      "locked": false,
      "text": "Sort rules (use the next rule only when the earlier values tie):\n1. Higher ranking score first.\n2. If scores tie: more votes first.\n3. If both tie: most recently updated first.\n4. If all three tie: title in ascending database text order.\n5. If titles also tie: canonical node GUID text in ascending order.\n\nExample: equal scores, but 12 votes versus 5 votes: the node with 12 votes comes first.\nThe database selects the requested slice; the app does not load all matching nodes.\nIf votes change before you request page 2, nodes can move between pages.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sort rules (use the next rule only when the earlier values tie):\n1. Higher ranking score first.\n2. If scores tie: more votes first.\n3. If both tie: most recently updated first.\n4. If all three tie: title in ascending database text order.\n5. If titles also tie: canonical node GUID text in ascending order.\n\nExample: equal scores, but 12 votes versus 5 votes: the node with 12 votes comes first.\nThe database selects the requested slice; the app does not load all matching nodes.\nIf votes change before you request page 2, nodes can move between pages.",
      "autoResize": true,
      "lineHeight": 1.25
    },
