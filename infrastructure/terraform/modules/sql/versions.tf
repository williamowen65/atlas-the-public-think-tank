# Provider source addresses are module-local. Without this declaration,
# Terraform assumes hashicorp/azapi instead of the published Azure/azapi.
terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.0"
    }
  }
}
