@inject IWebHostEnvironment env;

@{
    bool isTestOrDev = env.EnvironmentName == "Testing" || env.EnvironmentName == "Development";
}

<footer class="border-top footer" tabindex="0">
    <div class="container d-flex justify-content-between flex-column" style="transform: translateY(31px)">

        <div class="d-grid text-nowrap" id="footer-content">

                <div class="col">
                        <div>
                            About
                        </div>
                        <div>
                        <a tabindex="0" href="https://docs.google.com/forms/d/e/1FAIpQLSe9Rrh5GMt2k2ASV_fpoyG7xuEKaXQAXdeiFRQsbRHvWkaQeg/viewform">Mission</a>
                        </div>
                        <div>
                    <a tabindex="0" href="https://docs.google.com/forms/d/e/1FAIpQLSe10XIcu80UNABMJtgrU2eiW7Y2QoU_XSZtkgvdF5MODoDoxQ/viewform">How It Works</a>
                        </div>
                        <div>
                            <a tabindex="0" style="text-decoration: none" target="_blank" href="https://github.com/williamowen65/atlas-the-public-think-tank">
                                @Html.Partial("~/Views/Shared/Icons/_Github-logo.cshtml") Github
                            </a>
                        </div>
                   
                </div>
                <div class="col">
                    <div>
                        <a tabindex="0" asp-area="" asp-controller="Guides" style="text-decoration:none" asp-action="GuidesPage">Guides</a>
                    </div>
                    <div>
                        <a tabindex="0" asp-area="" asp-controller="Guides" style="text-decoration:none" asp-action="CreatingIssuesGuide">Creating Issues</a>
                    </div>
                    <div>
                        <a tabindex="0" asp-area="" asp-controller="Guides" style="text-decoration:none" asp-action="CreatingSolutionsGuide">Creating Solutions</a>
                    </div>
                </div>
                <div class="col">
                    <div>
                        Support
                    </div>
                    <div>
                    <a tabindex="0" href="https://www.gofundme.com/f/fund-william-owens-innovative-social-media-project/donate?source=the-public-think-tank">Donate ($25,000 goal)</a>
                    </div>
                    <div>
                        <a tabindex="0" href="https://incubator.thepublicthinktank.com">Visit the Project Incubator</a>
                    </div>
             
                </div>
                <div class="col">
                    <div>
                        Other
                    </div>
                    <div>
                        <a tabindex="0" asp-area="" asp-controller="Home" style="text-decoration:none" asp-action="Privacy">Privacy Policy</a>
                    </div>
                    <div>
                        <a tabindex="0" asp-area="" asp-controller="Home" style="text-decoration:none" asp-action="TermsPage">Terms of Use</a>
                    </div>
            </div>
        </div>

        <div>
            <div class="ff-consolas col-lg-4 mb-2 text-body-emphasis text-decoration-none fw-bold w-100" style="margin-top: 50px;">
                @await Html.PartialAsync("~/Views/Shared/Components/ThePublicThinkTank_Logo.cshtml")
        </div>
        <center style="font-size: 12px"> 
            &copy; @DateTime.Now.Year
        </center>
 
    </div>
</footer>