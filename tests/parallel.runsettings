<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Independent assemblies run in separate testhost processes. -->
    <MaxCpuCount>2</MaxCpuCount>
  </RunConfiguration>
  <MSTest>
    <Parallelize>
      <!-- Keep the default modest for local SQL Server memory and connection pressure. -->
      <Workers>2</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
</RunSettings>
